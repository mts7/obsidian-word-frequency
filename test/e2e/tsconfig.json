{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "lib": ["ES2022", "dom"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "@wdio/globals/types",
            "@wdio/mocha-framework",
            "wdio-obsidian-service"
        ]
    },
    "include": ["**/*.ts", "../../wdio.conf.mts"]
}
